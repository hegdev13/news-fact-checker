# Copy this file to .env and fill in real values. Never commit .env.

# Required for the Cross-Checker agent's LLM reasoning calls.
ANTHROPIC_API_KEY=

# Optional: model override for both agents (defaults set in src/newsfact/config.py)
NEWSFACT_MODEL=claude-sonnet-4-5

# GDELT DOC 2.0 API needs no key. Override the base URL only if you're
# pointing at a proxy/mirror.
GDELT_API_BASE=https://api.gdeltproject.org/api/v2/doc/doc

# Where the shared SQLite blackboard/cache lives.
NEWSFACT_DB_PATH=data/newsfact.db
