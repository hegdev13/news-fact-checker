# Copy this file to .env and fill in real values. Never commit .env.
#
# v2 note: with NONE of these set, `python -m newsfact.main --demo` still runs
# the full 5-agent pipeline and live dashboard offline using bundled fixtures.
# Set ANTHROPIC_API_KEY to switch Opposition / Cross-Checker / Writer to the
# real model; GDELT needs no key.

# Required to leave DEMO MODE. Used by the Opposition, Cross-Checker and Writer
# agents for their LLM reasoning calls.
ANTHROPIC_API_KEY=

# Optional: model override for every agent (default set in src/newsfact/config.py)
NEWSFACT_MODEL=claude-sonnet-4-5

# GDELT DOC 2.0 API needs no key. Override the base URL only if you're
# pointing at a proxy/mirror.
GDELT_API_BASE=https://api.gdeltproject.org/api/v2/doc/doc

# Where the shared SQLite blackboard / cache / audit log lives (live mode).
# Demo mode always uses data/newsfact-demo.db and resets it each run.
NEWSFACT_DB_PATH=data/newsfact.db

# Optional: path to your own outlet bias/factuality JSON (same shape as
# src/newsfact/resources/outlet_bias.json). Unset -> the bundled table is used.
NEWSFACT_BIAS_TABLE=
