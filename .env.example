# Copy this file to .env and fill in real values. Never commit .env.
#
# With NONE of these set, `python -m newsfact.main --demo` still runs the full
# 5-agent pipeline and live dashboard offline using bundled fixtures.
#
# ---------------------------------------------------------------------------
# LLM PROVIDER SELECTION
# ---------------------------------------------------------------------------
# Choose which LLM backend to use. Defaults to "anthropic".
# Valid values: anthropic | nvidia
#
NEWSFACT_LLM_PROVIDER=nvidia

# ---------------------------------------------------------------------------
# NVIDIA NIM (Mistral — and any other OpenAI-compatible NIM model)
# ---------------------------------------------------------------------------
# Get your key at: https://build.nvidia.com/  → "Get API Key"
# Endpoint: https://integrate.api.nvidia.com/v1  (set automatically)
#
# Install the extra dep first:
#   pip install -e ".[nvidia]"   or   pip install openai
#
NVIDIA_API_KEY=

# Model to use when NEWSFACT_LLM_PROVIDER=nvidia.
# Default (when NEWSFACT_MODEL is unset): mistralai/mistral-large-2-instruct
# Other good NIM options:
#   mistralai/mistral-small-latest
#   mistralai/mixtral-8x7b-instruct-v0.1
#   meta/llama-3.1-70b-instruct
#
# NEWSFACT_MODEL=mistralai/mistral-large-2-instruct

# ---------------------------------------------------------------------------
# ANTHROPIC (Claude)
# ---------------------------------------------------------------------------
# Required to leave DEMO MODE when NEWSFACT_LLM_PROVIDER=anthropic.
# Used by the Opposition, Cross-Checker, Claim Extractor and Writer agents.
#
ANTHROPIC_API_KEY=

# Model to use when NEWSFACT_LLM_PROVIDER=anthropic.
# Default (when NEWSFACT_MODEL is unset): claude-sonnet-4-5
#
# NEWSFACT_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# GDELT DOC 2.0  (no key required)
# ---------------------------------------------------------------------------
# Override the base URL only if you're pointing at a proxy/mirror.
GDELT_API_BASE=https://api.gdeltproject.org/api/v2/doc/doc

# ---------------------------------------------------------------------------
# SHARED STORE
# ---------------------------------------------------------------------------
# Where the SQLite blackboard / cache / audit log lives (live mode).
# Demo mode always uses data/newsfact-demo.db and resets it each run.
NEWSFACT_DB_PATH=data/newsfact.db

# ---------------------------------------------------------------------------
# BIAS TABLE (optional)
# ---------------------------------------------------------------------------
# Path to your own outlet bias/factuality JSON (same shape as
# src/newsfact/resources/outlet_bias.json). Unset → the bundled table is used.
NEWSFACT_BIAS_TABLE=
